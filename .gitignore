# Lightman Project - Strict .gitignore
# =====================================

# Sensitive data and local configs
.lightman_secrets/
data/
config/.secrets/
vendor/
.env
*.log

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
.venv/
dist/
build/
*.egg-info/
*.egg

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Editor backups
*.bak
*.tmp

# Testing
.pytest_cache/
.coverage
htmlcov/

# SQLite databases (runtime data)
*.db
*.db-journal
*.sqlite
*.sqlite3

# Local runtime
*.pid
*.lock

# Generated output
*.pdf
*.pyc

# Keep vendor/ tracked? No - vendor/ is excluded above
