/* ============================================================
   Lightman — Dark Theme (DaVinci Resolve inspired)
   All backgrounds dark. No white anywhere.
   ============================================================ */

* {
    font-family: "Segoe UI", "SF Pro Text", "Inter", "Roboto", sans-serif;
    font-size: 14px;
    color: #E6E6E6;
}

QWidget, QMainWindow, QDialog {
    background-color: #1E1E1E;
}

/* ------------------------------ Tabs ----------------------- */
QTabWidget::pane {
    background-color: #252526;
    border: 1px solid #333333;
    border-radius: 4px;
}
QTabBar::tab {
    background-color: #252526;
    color: #C8C8C8;
    padding: 8px 16px;
    margin-right: 2px;
    border: 1px solid #333333;
    border-bottom: none;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    min-width: 90px;
}
QTabBar::tab:selected {
    background-color: #2D2D30;
    color: #FFFFFF;
    border-color: #4A9EFF;
}
QTabBar::tab:hover:!selected { background-color: #2A2A2D; }

/* ------------------------------ Buttons -------------------- */
QPushButton {
    background-color: #2D2D30;
    color: #E6E6E6;
    border: 1px solid #3F3F46;
    border-radius: 6px;
    padding: 7px 16px;
    min-height: 22px;
    font-weight: 500;
}
QPushButton:hover {
    background-color: #3A3A40;
    border-color: #4A9EFF;
}
QPushButton:pressed {
    background-color: #4A9EFF;
    color: #FFFFFF;
}
QPushButton:disabled {
    background-color: #2A2A2A;
    color: #6A6A6A;
    border-color: #333333;
}

/* --------------------------- Line edits -------------------- */
QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox {
    background-color: #252526;
    color: #E6E6E6;
    border: 1px solid #3F3F46;
    border-radius: 4px;
    padding: 5px 8px;
    selection-background-color: #4A9EFF;
    selection-color: #FFFFFF;
}
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus,
QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: #4A9EFF;
}

/* ---------------------------- Combo box -------------------- */
QComboBox {
    background-color: #252526;
    color: #E6E6E6;
    border: 1px solid #3F3F46;
    border-radius: 4px;
    padding: 5px 8px;
    min-height: 22px;
}
QComboBox:hover { border-color: #4A9EFF; }
QComboBox:focus { border-color: #4A9EFF; }
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 22px;
    border-left: 1px solid #3F3F46;
    background-color: #2D2D30;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
}
QComboBox::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #C8C8C8;
    width: 0; height: 0;
    margin-right: 6px;
}
QComboBox QAbstractItemView {
    background-color: #252526;
    color: #E6E6E6;
    border: 1px solid #3F3F46;
    selection-background-color: #4A9EFF;
    selection-color: #FFFFFF;
    outline: 0;
}
QComboBox QAbstractItemView::item {
    padding: 6px 10px;
    min-height: 22px;
}
QComboBox QAbstractItemView::item:hover {
    background-color: #3A3A40;
}

/* ----------------------------- Trees ----------------------- */
QTreeWidget, QTreeView, QListWidget, QListView, QTableView {
    background-color: #252526;
    color: #E6E6E6;
    border: 1px solid #333333;
    border-radius: 4px;
    alternate-background-color: #2A2A2D;
    selection-background-color: #4A9EFF;
    selection-color: #FFFFFF;
    outline: 0;
}
QTreeWidget::item, QTreeView::item, QListWidget::item {
    padding: 4px 6px;
}
QTreeWidget::item:hover, QTreeView::item:hover, QListWidget::item:hover {
    background-color: #34343A;
}
QHeaderView::section {
    background-color: #2D2D30;
    color: #E6E6E6;
    padding: 6px 8px;
    border: none;
    border-right: 1px solid #333333;
    border-bottom: 1px solid #333333;
}

/* --------------------------- Group boxes ------------------- */
QGroupBox {
    background-color: #252526;
    border: 1px solid #3F3F46;
    border-radius: 6px;
    margin-top: 16px;
    padding: 14px 10px 10px 10px;
    font-weight: 600;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    padding: 0 6px;
    color: #4A9EFF;
    background-color: #1E1E1E;
}

/* ---------------------------- Splitter --------------------- */
QSplitter::handle { background-color: #333333; }
QSplitter::handle:horizontal { width: 2px; }
QSplitter::handle:vertical { height: 2px; }
QSplitter::handle:hover { background-color: #4A9EFF; }

/* -------------------------- Scroll bars -------------------- */
QScrollBar:vertical {
    background: #1E1E1E;
    width: 12px; margin: 0;
}
QScrollBar::handle:vertical {
    background: #3F3F46;
    min-height: 20px;
    border-radius: 6px;
}
QScrollBar::handle:vertical:hover { background: #4A9EFF; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }

QScrollBar:horizontal {
    background: #1E1E1E;
    height: 12px; margin: 0;
}
QScrollBar::handle:horizontal {
    background: #3F3F46;
    min-width: 20px;
    border-radius: 6px;
}
QScrollBar::handle:horizontal:hover { background: #4A9EFF; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }

/* ---------------------------- Menu bar --------------------- */
QMenuBar {
    background-color: #1E1E1E;
    color: #E6E6E6;
    border-bottom: 1px solid #333333;
}
QMenuBar::item:selected { background-color: #2D2D30; }
QMenu {
    background-color: #252526;
    color: #E6E6E6;
    border: 1px solid #333333;
}
QMenu::item:selected {
    background-color: #4A9EFF;
    color: #FFFFFF;
}

/* --------------------------- Status bar -------------------- */
QStatusBar {
    background-color: #252526;
    color: #C8C8C8;
    border-top: 1px solid #333333;
}
QStatusBar::item { border: none; }

/* ----------------------------- Docks ----------------------- */
QDockWidget {
    color: #E6E6E6;
    titlebar-close-icon: none;
    titlebar-normal-icon: none;
}
QDockWidget::title {
    background-color: #2D2D30;
    padding: 6px 10px;
    border-bottom: 1px solid #333333;
    font-weight: 600;
}

/* --------------------------- Progress bar ------------------ */
QProgressBar {
    background-color: #252526;
    border: 1px solid #3F3F46;
    border-radius: 4px;
    text-align: center;
    color: #E6E6E6;
    min-height: 20px;
}
QProgressBar::chunk {
    background-color: #4A9EFF;
    border-radius: 3px;
}

/* ----------------------------- Checkboxes ------------------ */
QCheckBox {
    spacing: 8px;
    color: #E6E6E6;
    background: transparent;
}
QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #3F3F46;
    border-radius: 3px;
    background-color: #252526;
}
QCheckBox::indicator:checked {
    background-color: #4A9EFF;
    border-color: #4A9EFF;
}

/* ------------------------------ Labels --------------------- */
QLabel {
    background: transparent;
    color: #E6E6E6;
}
QLabel#LoginTitle {
    font-size: 20px;
    font-weight: 700;
    color: #4A9EFF;
    padding: 8px 0;
}

/* ---------------------------- Tooltip ---------------------- */
QToolTip {
    background-color: #2D2D30;
    color: #E6E6E6;
    border: 1px solid #4A9EFF;
    padding: 4px 8px;
    border-radius: 4px;
}